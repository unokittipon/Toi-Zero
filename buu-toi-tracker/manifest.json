{
  "manifest_version": 3,
  "name": "BUU TOI Progress Tracker",
  "version": "3.1.0",
  "description": "Tracks A1 (20) and A2+A3 (20) goals on every contest page, with per-group sub-tabs and statement/submit/PDF buttons.",
  "permissions": ["storage"],
  "host_permissions": [
    "https://toi-coding.informatics.buu.ac.th/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://toi-coding.informatics.buu.ac.th/*"
      ],
      "js": ["content.js"],
      "css": ["content.css"],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_title": "BUU TOI Progress",
    "default_popup": "popup.html"
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
